# Documents the environment variables NPL Adda requires. Copy to .env and fill in.
# Production values (Neon, Render hosts) go in the Render dashboard; see DEPLOYMENT.md.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Serve uploaded media from Django when DEBUG is off (single-instance free hosting)
DJANGO_SERVE_MEDIA=False

# PostgreSQL (also read by the postgres container; compose points the app at it as host "db")
POSTGRES_DB=npl_adda
POSTGRES_USER=npl_adda
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Empty locally; "require" for hosted Postgres such as Neon
POSTGRES_SSLMODE=

# Redis (set to "none" to use an in-process memory cache instead)
REDIS_URL=redis://localhost:6379/0

# Host ports published by Docker Compose
WEB_PORT=9009
POSTGRES_HOST_PORT=5432

# Cloudinary (Dashboard -> API Keys). When all three are set, uploaded and rendered images go to Cloudinary;
# leave empty to keep them in the local media/ folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fan engagement
GUEST_SESSION_TTL_DAYS=30
PREDICTION_LOCK_MINUTES=0

# JWT lifetimes
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (public; no secret needed)
GOOGLE_CLIENT_ID=

# Auth rate limits and session lifetime
AUTH_RATE=10/min
AUTH_REGISTER_RATE=10/hour
SESSION_COOKIE_AGE_SECONDS=1209600

# Scaling: DB connection pool per worker (0 disables), query timeout, leaderboard cache, gunicorn workers
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_SIZE=2
DB_STATEMENT_TIMEOUT_MS=15000
LEADERBOARD_CACHE_SECONDS=60
WEB_CONCURRENCY=3

# Meme Zone AI captions (auto = Gemini when a key is set, else offline templates; or gemini | mock)
MEME_CAPTION_PROVIDER=auto
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview,gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=15

# Meme Zone (REQUIRE_REVIEW=True holds new content for staff approval; BLOCKED_TERMS is comma-separated)
MEME_REQUIRE_REVIEW=False
POST_REQUIRE_REVIEW=False
MEME_UPLOAD_MAX_BYTES=5242880
MEME_BLOCKED_TERMS=
MEME_GENERATION_RATE=20/hour
MEME_RENDER_RATE=60/min
MEME_UPLOAD_RATE=20/hour
MEME_ENGAGE_RATE=60/min
MEME_COMMENT_RATE=10/min
AVATAR_UPLOAD_RATE=10/hour
