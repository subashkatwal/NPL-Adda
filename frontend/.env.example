# Copy to .env.local (git-ignored). Only public values belong here: Vite bundles them into the browser.

# Google OAuth 2.0 *Web* client ID (same value as the backend's GOOGLE_CLIENT_ID). Not a secret.
VITE_GOOGLE_CLIENT_ID=

# Optional: API location. Default uses the dev proxy (/api -> http://localhost:9009).
# VITE_PROXY_TARGET=http://localhost:9009
# VITE_API_BASE_URL=/api/v1
